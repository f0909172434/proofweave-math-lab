{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/source.schema.json",
  "title": "Opened and auditable source",
  "type": "object",
  "required": ["source_id", "title", "authors_or_organization", "publication_date", "url", "accessed_at", "source_type", "trust_level", "project_use", "exact_claim_supported", "status"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "authors_or_organization": {"type": "string", "minLength": 1},
    "publication_date": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "accessed_at": {"type": "string", "format": "date-time"},
    "opened_at": {"type": ["string", "null"], "format": "date-time"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "verified_by": {"type": ["string", "null"]},
    "source_type": {"enum": ["ORIGINAL_PAPER", "OFFICIAL_DOCUMENTATION", "OFFICIAL_REPOSITORY", "OFFICIAL_TECHNICAL_REPORT", "PUBLISHER_PAGE", "STANDARD", "DATASET", "OTHER"]},
    "trust_level": {"enum": ["PRIMARY_HIGH", "PRIMARY_LIMITED", "SECONDARY", "UNKNOWN"]},
    "project_use": {"type": "string"},
    "exact_claim_supported": {"type": "string"},
    "status": {"enum": ["FOUND", "OPENED", "VERIFIED", "RETRACTED", "CONFLICT", "UNKNOWN"]},
    "license": {"type": "string"},
    "bibtex_key": {"type": ["string", "null"]},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}

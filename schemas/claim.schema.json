{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/claim.schema.json",
  "title": "ProofWeave Core claim revision",
  "type": "object",
  "required": ["schema_version", "claim_id", "revision_id", "title", "statement", "assumptions", "quantifiers", "dependencies", "statement_hash", "source_path", "source_hash", "alignment", "proof_status", "lifecycle", "latest_run_id", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "revision_id": {"type": "string", "minLength": 16},
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "quantifiers": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "statement_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_path": {"type": "string"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formal_target_hash": {"type": ["string", "null"]},
    "alignment_hash": {"type": ["string", "null"]},
    "alignment": {"enum": ["UNCONFIRMED", "CONFIRMED", "STALE"]},
    "proof_status": {"enum": ["UNVERIFIED", "PARTIAL", "CERTIFIED", "FAILED"]},
    "lifecycle": {"enum": ["ACTIVE", "SUPERSEDED", "REVOKED"]},
    "latest_run_id": {"type": ["string", "null"]},
    "certificate_digest": {"type": ["string", "null"]},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}

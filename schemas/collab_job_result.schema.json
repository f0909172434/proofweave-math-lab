{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/collab_job_result.schema.json",
  "title": "AI Collaboration Console result ledger record",
  "type": "object",
  "required": ["event_id", "recorded_at", "request_id", "job_id", "task_id", "status", "research_status", "summary", "reasoning_summary", "primary", "requested_effort", "effective_effort", "usage", "reviewer", "review_state", "disagreements", "artifacts", "evidence_status", "spend", "fallback"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": ["string", "null"]},
    "job_id": {"type": ["string", "null"]},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "needs_review", "awaiting_manual", "needs_attention", "COLLAB_UNAVAILABLE"]},
    "research_status": {"enum": ["PROPOSED", "COMPUTATIONAL", "OPEN", null]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "summary": {"type": "string", "minLength": 1},
    "reasoning_summary": {"type": ["string", "null"], "maxLength": 2000},
    "primary": {
      "type": ["object", "null"],
      "required": ["provider", "model", "model_family"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requested_effort": {
      "type": "object",
      "required": ["profile", "level"],
      "properties": {"profile": {"type": "string", "minLength": 1}, "level": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "effective_effort": {
      "type": "object",
      "required": ["profile", "level"],
      "properties": {"profile": {"type": "string", "minLength": 1}, "level": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "duration_ms"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": ["object", "null"],
      "required": ["provider", "model", "model_family", "independent"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "independent": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "review_state": {"enum": ["not_required", "pending", "accepted", "disputed", "unavailable"]},
    "disagreements": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "locator", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "evidence_status": {"enum": ["PROPOSED", "COMPUTATIONAL", "OPEN", "NONE"]},
    "spend": {
      "type": "object",
      "required": ["actual_usd", "actual_cny", "http_status", "retry_count"],
      "properties": {
        "actual_usd": {"type": ["number", "null"], "minimum": 0, "maximum": 0.7},
        "actual_cny": {"type": ["number", "null"], "minimum": 0, "maximum": 5.0},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 0}
      },
      "additionalProperties": false
    },
    "fallback": {"const": "proofweave_native"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/context_packet.schema.json",
  "title": "Content-addressed cold-start context packet",
  "type": "object",
  "required": [
    "schema_version", "compiler_version", "packet_id", "packet_digest",
    "cache_key", "cache_path", "status", "budget", "input_manifest",
    "task", "role", "target_fact", "verified_dependencies", "artifacts",
    "sources", "policy", "exclusions"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "compiler_version": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 71},
    "packet_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "cache_key": {"type": "string", "minLength": 64, "maxLength": 64},
    "cache_path": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY", "NEEDS_CONTEXT_REVIEW"]},
    "budget": {
      "type": "object",
      "required": ["mode", "limit_tokens", "estimation", "utf8_bytes", "estimated_tokens", "truncated"],
      "properties": {
        "mode": {"enum": ["fast", "standard", "deep", "max"]},
        "limit_tokens": {"type": "integer", "minimum": 8000, "maximum": 32000},
        "estimation": {"type": "string", "minLength": 1},
        "utf8_bytes": {"type": "integer", "minimum": 0},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "truncated": {"const": false}
      },
      "additionalProperties": false
    },
    "input_manifest": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["kind", "label", "format", "raw_digest"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "raw_digest": {"type": "string", "minLength": 64, "maxLength": 64}
        },
        "additionalProperties": false
      }
    },
    "task": {"$ref": "#/$defs/input"},
    "role": {"$ref": "#/$defs/input"},
    "target_fact": {"$ref": "#/$defs/fact"},
    "verified_dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/material"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/material"}
    },
    "policy": {
      "type": "object",
      "required": ["documents", "digest"],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "minLength": 64, "maxLength": 64}
            },
            "additionalProperties": false
          }
        },
        "digest": {"type": "string", "minLength": 64, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input", "reason"],
        "properties": {
          "input": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": ["format", "source", "payload"],
      "properties": {
        "format": {"enum": ["json", "markdown", "text"]},
        "source": {"type": "string", "minLength": 1},
        "payload": {"type": ["object", "string"]}
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "fact_id", "title", "kind", "statement", "normalized_statement",
        "assumptions", "quantifiers", "mathematical_domain", "dependencies",
        "source_dependencies", "status", "digest"
      ],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "statement": {"type": ["string", "null"]},
        "normalized_statement": {"type": ["string", "null"]},
        "assumptions": {"type": ["array", "null"]},
        "quantifiers": {"type": ["array", "null"]},
        "mathematical_domain": {"type": ["string", "null"]},
        "proof": {"type": ["string", "null"]},
        "dependencies": {"type": ["array", "null"]},
        "source_dependencies": {"type": ["array", "null"]},
        "status": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 64, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": ["label", "format", "content", "digest"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "content": {"type": ["object", "array", "string", "integer", "number", "boolean", "null"]},
        "digest": {"type": "string", "minLength": 64, "maxLength": 64}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

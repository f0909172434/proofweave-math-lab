{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/benchmark_result.schema.json",
  "title": "Model benchmark case result",
  "type": "object",
  "required": ["run_id", "case_id", "dataset_version", "visibility", "category", "provider", "model_id", "model_snapshot", "reasoning_setting", "prompt_version", "correct", "false_acceptance", "false_rejection", "estimated_cost", "actual_cost", "latency_ms", "recorded_at"],
  "properties": {
    "run_id": {"type": "string"}, "case_id": {"type": "string"}, "dataset_version": {"type": "string"},
    "visibility": {"enum": ["PUBLIC", "HIDDEN"]}, "category": {"type": "string"},
    "provider": {"type": "string"}, "model_id": {"type": "string"}, "model_snapshot": {"type": ["string", "null"]},
    "reasoning_setting": {"type": ["string", "null"]}, "prompt_version": {"type": "string"},
    "correct": {"type": "boolean"}, "false_acceptance": {"type": "boolean"}, "false_rejection": {"type": "boolean"},
    "estimated_cost": {"type": ["number", "null"]}, "actual_cost": {"type": ["number", "null"]}, "latency_ms": {"type": ["number", "null"]},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

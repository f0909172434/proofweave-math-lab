{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/model_capability.schema.json",
  "title": "Detected model capability",
  "type": "object",
  "required": ["provider", "model_id", "display_name", "aliases", "availability_status", "availability_evidence", "detection_method", "last_checked_at", "account_verified", "reasoning_support", "supported_reasoning_levels", "context_window", "max_output_tokens", "text_input", "image_input", "pdf_input", "structured_output", "tool_calling", "web_search", "file_search", "code_execution", "computer_use", "MCP_support", "streaming", "snapshot_support", "estimated_input_cost", "estimated_output_cost", "latency_class", "rate_limit_information", "deprecation_status", "provider_adapter", "notes"],
  "properties": {
    "provider": {"type": "string"},
    "model_id": {"type": "string"},
    "display_name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "model_family": {"type": "string"},
    "availability_status": {"enum": ["VERIFIED_AVAILABLE", "CONFIGURED_UNVERIFIED", "PUBLICLY_LISTED", "UNAVAILABLE", "UNKNOWN", "DEPRECATED"]},
    "availability_evidence": {"type": "string"},
    "detection_method": {"type": "string"},
    "last_checked_at": {"type": "string", "format": "date-time"},
    "account_verified": {"type": "boolean"},
    "reasoning_support": {"type": "boolean"},
    "supported_reasoning_levels": {"type": "array", "items": {"type": "string"}},
    "context_window": {"type": ["integer", "null"]},
    "max_output_tokens": {"type": ["integer", "null"]},
    "text_input": {"type": "boolean"}, "image_input": {"type": "boolean"}, "pdf_input": {"type": "boolean"},
    "structured_output": {"type": "boolean"}, "tool_calling": {"type": "boolean"}, "web_search": {"type": "boolean"},
    "file_search": {"type": "boolean"}, "code_execution": {"type": "boolean"}, "computer_use": {"type": "boolean"},
    "MCP_support": {"type": "boolean"}, "streaming": {"type": "boolean"}, "snapshot_support": {"type": "boolean"},
    "estimated_input_cost": {"type": ["number", "null"]}, "estimated_output_cost": {"type": ["number", "null"]},
    "latency_class": {"type": "string"}, "rate_limit_information": {"type": "string"},
    "deprecation_status": {"enum": ["ACTIVE", "DEPRECATED", "UNKNOWN"]},
    "provider_adapter": {"type": "string"},
    "capability_tier": {"enum": ["UTILITY", "STANDARD", "ADVANCED", "FRONTIER"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}

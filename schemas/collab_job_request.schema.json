{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/collab_job_request.schema.json",
  "title": "AI Collaboration Console job request",
  "type": "object",
  "required": ["request_id", "created_at", "task_id", "objective", "role", "research_status", "risk", "sensitivity", "context_packet_digest", "capability_tags", "effort", "limits", "spend", "review", "workspace_operations", "fallback"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "role": {"enum": ["coding", "math", "research", "scientific_writing", "teaching_material", "data_analysis", "summarization", "translation", "review", "general"]},
    "research_status": {"enum": ["PROPOSED", "OPEN", "COMPUTATIONAL"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "sensitivity": {"enum": ["public", "private", "restricted"]},
    "context_packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "effort": {
      "type": "object",
      "required": ["profile", "requested", "native_mapping"],
      "properties": {
        "profile": {"enum": ["fast", "standard", "deep", "max"]},
        "requested": {"enum": ["low", "medium", "high", "xhigh"]},
        "native_mapping": {"enum": ["low", "medium", "high", "xhigh"]}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["max_input_tokens", "max_output_tokens", "max_rounds"],
      "properties": {
        "max_input_tokens": {"enum": [8000, 16000, 24000, 32000]},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_rounds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "spend": {
      "type": "object",
      "required": ["authorization", "maximum_usd", "maximum_cny", "estimated_cost_usd", "retry_on_402"],
      "properties": {
        "authorization": {"const": "existing_balance"},
        "maximum_usd": {"const": 0.7},
        "maximum_cny": {"const": 5.0},
        "estimated_cost_usd": {"type": "number", "minimum": 0, "maximum": 0.7},
        "retry_on_402": {"const": false}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["required", "different_model_family_required", "unknown_family_is_independent", "copilot_auto_is_independent"],
      "properties": {
        "required": {"type": "boolean"},
        "different_model_family_required": {"type": "boolean"},
        "unknown_family_is_independent": {"const": false},
        "copilot_auto_is_independent": {"const": false}
      },
      "additionalProperties": false
    },
    "workspace_operations": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"const": false}},
      "additionalProperties": false
    },
    "fallback": {"const": "proofweave_native"}
  },
  "additionalProperties": false
}

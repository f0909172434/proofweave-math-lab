{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/provider_status.schema.json",
  "title": "Provider detection status",
  "type": "object",
  "required": ["checked_at", "providers", "paid_probe_performed"],
  "properties": {
    "checked_at": {"type": "string", "format": "date-time"},
    "providers": {"type": "object"},
    "paid_probe_performed": {"const": false},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

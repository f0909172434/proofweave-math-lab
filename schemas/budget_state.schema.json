{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/budget_state.schema.json",
  "title": "Budget and bounded-escalation state",
  "type": "object",
  "required": ["mode", "currency", "per_task_budget", "per_workflow_budget", "daily_budget", "monthly_budget", "maximum_parallel_agents", "maximum_frontier_calls", "maximum_reasoning_escalations", "maximum_model_escalations", "maximum_provider_switches", "maximum_repair_loops", "maximum_paid_probes", "provider_specific_limits", "spent_today", "spent_month", "frontier_calls", "reasoning_escalations", "model_escalations", "provider_switches", "paid_probes"],
  "properties": {
    "mode": {"enum": ["ECONOMY", "BALANCED", "QUALITY_FIRST", "MANUAL"]},
    "currency": {"type": "string"},
    "per_task_budget": {"type": ["number", "null"]}, "per_workflow_budget": {"type": ["number", "null"]},
    "daily_budget": {"type": ["number", "null"]}, "monthly_budget": {"type": ["number", "null"]},
    "maximum_parallel_agents": {"type": "integer", "minimum": 1}, "maximum_frontier_calls": {"type": "integer", "minimum": 0},
    "maximum_reasoning_escalations": {"type": "integer", "minimum": 0}, "maximum_model_escalations": {"type": "integer", "minimum": 0},
    "maximum_provider_switches": {"type": "integer", "minimum": 0}, "maximum_repair_loops": {"type": "integer", "minimum": 0},
    "maximum_paid_probes": {"type": "integer", "minimum": 0}, "provider_specific_limits": {"type": "object"},
    "spent_today": {"type": "number", "minimum": 0}, "spent_month": {"type": "number", "minimum": 0},
    "frontier_calls": {"type": "integer", "minimum": 0}, "reasoning_escalations": {"type": "integer", "minimum": 0},
    "model_escalations": {"type": "integer", "minimum": 0}, "provider_switches": {"type": "integer", "minimum": 0},
    "paid_probes": {"type": "integer", "minimum": 0}, "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofweave.local/schemas/routing_decision.schema.json",
  "title": "Explainable model routing decision",
  "type": "object",
  "required": ["routing_id", "status", "selected_provider", "selected_model", "selected_capability_tier", "requested_reasoning_profile", "effective_reasoning_setting", "reasoning_control_method", "routing_reason", "rejected_candidates", "estimated_cost", "expected_latency", "fallback_chain", "escalation_conditions", "independence_status", "model_inventory_version", "created_at"],
  "properties": {
    "routing_id": {"type": "string"},
    "status": {"enum": ["RECOMMENDED", "ADVISORY_ONLY", "BLOCKED_BY_BUDGET", "NEEDS_HUMAN_DECISION", "ROUTING_FAILED"]},
    "selected_provider": {"type": ["string", "null"]},
    "selected_model": {"type": ["string", "null"]},
    "selected_capability_tier": {"enum": ["UTILITY", "STANDARD", "ADVANCED", "FRONTIER"]},
    "requested_reasoning_profile": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "VERY_HIGH", "MAXIMUM"]},
    "effective_reasoning_setting": {"type": ["string", "null"]},
    "reasoning_control_method": {"enum": ["NATIVE", "PROMPT_OR_LOOP_BASED", "HOST_UNSUPPORTED"]},
    "routing_reason": {"type": "string"},
    "score_components": {"type": "object"},
    "rejected_candidates": {"type": "array"},
    "estimated_cost": {"type": ["number", "null"]},
    "expected_latency": {"type": "string"},
    "fallback_chain": {"type": "array", "items": {"type": "string"}},
    "escalation_conditions": {"type": "array", "items": {"type": "string"}},
    "independence_status": {"type": "string"},
    "model_inventory_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
